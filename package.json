{
  "name": "snake-game-with-skr-domains",
  "version": "1.0.0",
  "description": "Solana Snake Game with .skr domain integration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:coinpusher": "vite coin-pusher --port 5175",
    "dev:kids-vault": "vite kids-vault-web --port 5174",
    "dev:fatherhood": "cd fatherhood && npm run dev",
    "build": "vite build",
    "generate:creatures": "node scripts/generate-creature-portraits.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "preview": "vite preview",
    "pvp-server": "node server/server.cjs",
    "build:mwa": "node build-mwa.cjs",
    "fetch-skr-domains": "node fetch-all-skr-domains-simple.js",
    "convert-csv": "node convert-csv-to-lookup.js",
    "token:devnet": "node scripts/create-arcade-token-devnet.mjs",
    "test:p2e": "anchor test -p p2e_quest --run tests/p2e_quest.ts --provider.cluster localnet",
    "test:marketplace": "anchor test -p skr_marketplace --provider.cluster localnet",
    "p2e:copy-idl": "node p2e-quest/scripts/copy-idl.mjs",
    "p2e:devnet-init": "node scripts/p2e-quest-devnet-init.mjs"
  },
  "dependencies": {
    "@onsol/tldparser": "^0.5.2",
    "@solana-mobile/wallet-standard-mobile": "^0.4.1",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.87.6",
    "@supabase/supabase-js": "^2.99.2",
    "@wallet-standard/core": "^1.0.3",
    "leaflet": "^1.9.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@solana/spl-token": "^0.4.14",
    "chai": "^4.4.1",
    "esbuild": "^0.27.0",
    "mocha": "^10.4.0",
    "ts-mocha": "^10.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.1"
  }
}
